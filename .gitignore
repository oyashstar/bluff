# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
# App, not a published package — let the lockfile float in dev.
pubspec.lock
*.iml
.idea/
.vscode/

# Platform build dirs are generated by `flutter create .` on first setup and
# are intentionally not committed in this skeleton.
android/
ios/
web/
macos/
linux/
windows/

# Secrets / local config — NEVER commit keys. anon key is passed via
# --dart-define; the service-role key never touches this repo.
.env
.env.*
*.pem

# Supabase local stack
supabase/.branches/
supabase/.temp/
.supabase/
